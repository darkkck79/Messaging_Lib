  "cards": [
    {
      "dot": "cyan",
      "title": "Lowest Common Denominator API",
      "items": [
        "Unifies push brokers (JMS) and pull-based log streams (Kafka)",
        "At-least-once delivery with immutable Message and string headers",
        "Topic (ephemeral fan-out) vs Queue (durable competing consumers)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Strict Owner-Loop Concurrency",
      "items": [
        "Handler futures never touch thread-confined broker clients",
        "Kafka commits on poll thread; JMS commits on transacted receive loop",
        "One in-flight message per consumer unit guarantees partition order"
      ]
    },
    {
      "dot": "rose",
      "title": "Conformance & Portability Proof",
      "items": [
        "Abstract suite shared via java-test-fixtures across all adapters",
        "Negative control meta-tests assert suite fails on broken transports",
        "Proven against Apache Artemis, IBM MQ, and Apache Kafka"
      ]
    }
  ]
